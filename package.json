{
  "name": "react-flow-scrollbar",
  "version": "0.1.0",
  "description": "Custom, viewport-synced scrollbars and bounded panning (translateExtent) for React Flow / @xyflow/react v13.",
  "keywords": [
    "react-flow",
    "reactflow",
    "xyflow",
    "scrollbar",
    "scrollbars",
    "viewport",
    "pan",
    "translateExtent",
    "react",
    "diagram"
  ],
  "license": "MIT",
  "author": "Laststance.io",
  "homepage": "https://github.com/laststance/react-flow-scrollbar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laststance/react-flow-scrollbar.git"
  },
  "bugs": {
    "url": "https://github.com/laststance/react-flow-scrollbar/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "example:dev": "vite examples/playground",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "push-release-commit": "push-release-commit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@xyflow/react": "^13.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@laststance/npm-publish-tool": "^2.1.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "release-it": "^21.1.3",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
